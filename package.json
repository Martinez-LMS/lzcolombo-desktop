{
  "name": "lzcolombo-desktop",
  "version": "1.0.5",
  "description": "VLeon — app de desktop (wrapper Electron do site hospedado)",
  "main": "main.js",
  "author": "VLeon",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.vleon.desktop",
    "productName": "VLeon",
    "icon": "build/icon.ico",
    "artifactName": "${productName}-Setup.exe",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Martinez-LMS",
      "repo": "lzcolombo-desktop",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VLeon"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
